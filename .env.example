# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-3.5-flash-lite

# From @BotFather on Telegram after creating a bot with /newbot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Numeric Telegram chat id that operational alerts go to (pipeline stalled, scraper failed,
# send queue stuck, backup stale), plus the "someone just signed up" DM. Message @userinfobot
# to get yours. Unset -> alerts logged only, never sent.
#
# This is ALSO the only key to the operator analytics: the bot answers /stats for this chat id
# and no other (exact match, and nobody at all when it's unset - see workers/telegram_bot.py's
# is_operator). That output contains every subscriber's email and home address, so treat this
# value as a credential: if your Telegram account is compromised, rotate it here immediately.
OPERATOR_CHAT_ID=

# Brevo (free tier, 300 emails/day) - dashboard: SMTP & API -> SMTP tab for LOGIN/KEY, and
# Senders, Domains & Dedicated IPs -> Senders to verify EMAIL_FROM_ADDRESS before it can send.
BREVO_SMTP_LOGIN=your-brevo-login-email
BREVO_SMTP_KEY=your-brevo-smtp-key
EMAIL_FROM_ADDRESS=your-verified-sender@example.com
EMAIL_FROM_NAME=NajavaRadova.rs
# Optional second verified sender used ONLY for magic-link login/confirm mail, so it keeps its
# own deliverability reputation apart from outage notifications. Leave unset to send login mail
# from EMAIL_FROM_ADDRESS. Verify this address in Brevo -> Senders first, same as the one above.
LOGIN_EMAIL_FROM_ADDRESS=
LOGIN_EMAIL_FROM_NAME=NajavaRadova.rs

# Live site data API (the Cloudflare Worker in cf/worker.js).
# WEB_DATA_API   = the Worker's base URL, e.g. https://api.najavaradova.rs
# WEB_DATA_TOKEN = the PUBLISH_TOKEN secret set on that Worker
# Used by scripts/publish_web_data.py to push the feed after a scrape.
WEB_DATA_API=https://api.najavaradova.rs
WEB_DATA_TOKEN=
