# Copy to deploy/backup.env and fill in real values. That file is gitignored
# and must never be committed — it holds live R2 credentials.

# Cloudflare dashboard -> R2 -> Overview page
R2_ACCOUNT_ID=your-account-id-here

# Cloudflare dashboard -> R2 -> Manage API Tokens -> Create API Token
# (scope: Object Read & Write, restricted to the backup bucket)
R2_ACCESS_KEY_ID=your-access-key-id-here
R2_SECRET_ACCESS_KEY=your-secret-access-key-here

# The bucket you created for backups, e.g. outage-notifier-backups
R2_BUCKET=outage-notifier-backups
